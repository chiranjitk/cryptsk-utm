// ═════════════════════════ PHASE 2 — GROWTH (Enterprise features, M12–M23) ═════════════════════════
// Owner directive 2026-11-07: full Phase 2 console, production-ready for Debian 13 move.
// Style: JSON-string logical refs (no heavy FKs) per Phase 1 convention. All additive.

// ───────────────── M12 — Enhanced Logging & Reporting (spec 2.13) ─────────────────

model SavedLogSearch {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1) @map("tenant_id")
  name      String
  dataset   String   // firewall | ips | audit | dns | email | waf | url | app
  queryText String   @default("") @map("query_text") // full-text query
  filters   String   @default("{}") // JSON: severity, action, range, clientIp, ...
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("saved_log_searches")
}

model ComplianceTemplate {
  id         Int       @id @default(autoincrement())
  tenantId   Int       @default(1) @map("tenant_id")
  name       String
  framework  String    // PCI | HIPAA | GDPR | ISO27001 | SOC2
  sections   String    @default("[\"traffic\",\"threats\",\"audit\"]") // JSON array
  range      String    @default("monthly") // daily | weekly | monthly | quarterly
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("compliance_templates")
}

model ReportRun {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @default(1) @map("tenant_id")
  name             String
  source           String    @default("ad-hoc") // ad-hoc | schedule | compliance
  scheduleId       Int?      @map("schedule_id") // logical ref → report_schedules
  templateId       Int?      @map("template_id") // logical ref → compliance_templates
  range            String    @default("daily") // daily | weekly | monthly | quarterly
  format           String    @default("pdf") // pdf | html | csv | json
  sections         String    @default("[\"traffic\",\"threats\"]") // JSON array
  status           String    @default("pending") // pending | running | done | failed
  summary          String    @default("{}") // JSON result rollups (totals, top rows, series)
  contentHtml      String?   @map("content_html") // rendered report (print-friendly)
  error            String?
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("report_runs")
}

model AnonymizationRule {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1) @map("tenant_id")
  name      String
  dataset   String   // firewall | ips | audit | dns | email | waf
  field     String   // source_ip | user_name | url | email ...
  strategy  String   @default("hash") // hash | mask | pseudonymize
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("anonymization_rules")
}

// ───────────────── M13 — Threat Intelligence (spec 2.11) ─────────────────

model ThreatFeed {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @default(1) @map("tenant_id")
  name            String
  provider        String    @default("abusech") // abusech | otx | spamhaus | custom
  url             String    // feed URL (sandbox: simulated ingestion)
  format          String    @default("csv") // csv | json | stix | taxii
  category        String    @default("botnet") // botnet | malware | phishing | c2 | ransomware | scanner
  intervalMinutes Int       @default(60) @map("interval_minutes")
  autoBlock       Boolean   @default(false) @map("auto_block") // create AutoBlockRule per new IOC
  enabled         Boolean   @default(true)
  lastSyncAt      DateTime? @map("last_sync_at")
  lastStatus      String    @default("never") @map("last_status") // ok | error | never
  lastCount       Int       @default(0) @map("last_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("threat_feeds")
}

model Ioc {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @default(1) @map("tenant_id")
  feedId      Int?      @map("feed_id") // logical ref → threat_feeds (null = manual)
  type        String    // ip | cidr | domain | url | hash
  value       String
  category    String    @default("malware") // botnet | malware | phishing | c2 | ransomware | scanner
  severity    String    @default("warning") // info | warning | critical
  confidence  Int       @default(70) // 0-100
  reputation  Int       @default(20) // 0-100 (100 = fully benign)
  source      String    @default("manual") // manual | feed:<name>
  description String?
  hits        Int       @default(0) // matched-in-traffic counter
  enabled     Boolean   @default(true)
  firstSeen   DateTime  @default(now()) @map("first_seen")
  lastSeen    DateTime  @default(now()) @map("last_seen")
  expiresAt   DateTime? @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type, value])
  @@index([tenantId, severity])
  @@map("iocs")
}

model AutoBlockRule {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1) @map("tenant_id")
  name       String
  iocId      Int?     @map("ioc_id") // logical ref → iocs
  matchType  String   // ip | cidr | domain | url | hash
  matchValue String   @map("match_value")
  action     String   @default("drop") // drop | reject | quarantine_vlan
  direction  String   @default("both") // in | out | both
  source     String   @default("manual") // manual | auto-feed
  hitCount   Int      @default(0) @map("hit_count")
  enabled    Boolean  @default(true)
  createdBy  String   @default("admin") @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, matchType, matchValue])
  @@map("auto_block_rules")
}

model IocHit {
  id      Int      @id @default(autoincrement())
  tenantId Int     @default(1) @map("tenant_id")
  iocId   Int      @map("ioc_id") // logical ref → iocs
  sourceIp String  @map("source_ip")
  destIp   String? @map("dest_ip")
  action   String  // allowed | blocked | quarantined
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("ioc_hits")
}

// ───────────────── M14 — PKI (spec 2.12) ─────────────────

model CertificateAuthority {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @default(1) @map("tenant_id")
  name         String
  type         String   @default("root") // root | subordinate
  commonName   String   @map("common_name")
  org          String?  @map("org")
  keyType      String   @default("rsa2048") @map("key_type") // rsa2048 | rsa4096 | ec256 | ec384
  validityDays Int      @default(3650) @map("validity_days")
  parentCaId   Int?     @map("parent_ca_id") // logical self-ref (subordinate signed by root)
  serial       String   @default("")
  certPem      String   @default("") @map("cert_pem") // real PEM via node-forge (sandbox PKI is genuine crypto)
  keyPem       String   @default("") @map("key_pem") // private key PEM — masked in API responses
  status       String   @default("active") // active | revoked | expired
  crlUrl       String?  @map("crl_url")
  ocspUrl      String?  @map("ocsp_url")
  autoRenew    Boolean  @default(false) @map("auto_renew")
  notBefore    DateTime? @map("not_before")
  notAfter     DateTime? @map("not_after")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("certificate_authorities")
}

model Certificate {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @default(1) @map("tenant_id")
  caId         Int       @map("ca_id") // logical ref → certificate_authorities
  name         String
  commonName   String    @map("common_name")
  sans         String    @default("[]") @map("sans") // JSON array: DNS:x, IP:y
  type         String    @default("server") // server | client | device | user
  issuedFor    String    @default("general") @map("issued_for") // ssl_inspect | waf | vpn | email | general
  keyType      String    @default("rsa2048") @map("key_type")
  validityDays Int       @default(365) @map("validity_days")
  serial       String    @default("")
  certPem      String    @default("") @map("cert_pem")
  keyPem       String    @default("") @map("key_pem") // masked in responses; reveal endpoint like RADIUS
  status       String    @default("active") // active | revoked | expired
  revocationReason String? @map("revocation_reason")
  autoRenew    Boolean   @default(true) @map("auto_renew")
  notBefore    DateTime? @map("not_before")
  notAfter     DateTime? @map("not_after")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("certificates")
}

model CertRevocation { // CRL/OCSP simulation ledger
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1) @map("tenant_id")
  certId    Int      @map("cert_id") // logical ref → certificates
  caId      Int      @map("ca_id") // logical ref → certificate_authorities
  serial    String
  reason    String   @default("unspecified") // unspecified | keyCompromise | caCompromise | superseded | ceaseOfOperation
  revokedAt DateTime @default(now()) @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("cert_revocations")
}

// ───────────────── M15 — SSL/TLS Inspection (spec 2.1) ─────────────────

model SslInspectionPolicy {
  id                  Int      @id @default(autoincrement())
  tenantId            Int      @default(1) @map("tenant_id")
  name                String
  mode                String   @default("selective") // none | selective | full
  signingCaId         Int?     @map("signing_ca_id") // logical ref → certificate_authorities
  hstsHandling        String   @default("honor") @map("hsts_handling") // honor | bypass
  certPinningAction   String   @default("bypass") @map("cert_pinning_action") // bypass | block
  invalidCertAction   String   @default("block") @map("invalid_cert_action") // block | warn_bypass
  minTlsVersion       String   @default("1.2") @map("min_tls_version") // 1.2 | 1.3
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("ssl_inspection_policies")
}

model SslBypassRule {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1) @map("tenant_id")
  policyId   Int      @map("policy_id") // logical ref → ssl_inspection_policies
  matchType  String   @default("domain") @map("match_type") // domain | wildcard | category | ip | cidr
  matchValue String   @map("match_value") // e.g. *.bank.example, banking, 10.0.0.0/8
  reason     String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("ssl_bypass_rules")
}

model SslInspectionLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1) @map("tenant_id")
  clientIp   String   @map("client_ip")
  serverSni  String   @map("server_sni")
  action     String   // inspected | bypassed | blocked
  reason     String   // policy | pinning | invalid_cert | bypass_rule | hsts
  tlsVersion String?  @map("tls_version")
  cipher     String?
  policyId   Int?     @map("policy_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("ssl_inspection_logs")
}

