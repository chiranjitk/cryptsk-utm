  name        String
  matchDomain String   @map("match_domain")
  action      String   @default("relay") // deliver | relay | reject | quarantine
  targetHost  String?  @map("target_host")
  priority    Int      @default(10)
  enabled     Boolean  @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("email_routing_rules")
}

model EmailLog {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @default(1) @map("tenant_id")
  fromAddr          String   @map("from_addr")
  toAddr            String   @map("to_addr")
  subject           String?
  spamScore         Float    @default(0) @map("spam_score")
  verdict           String   // delivered | quarantined | rejected
  reasons           String   @default("[]") // JSON: ["spam_score", "blocked_extension", "dmarc_fail"]
  spfResult         String?  @map("spf_result") // pass | fail | softfail | none
  dkimResult        String?  @map("dkim_result")
  dmarcResult       String?  @map("dmarc_result")
  attachmentsScanned Int     @default(0) @map("attachments_scanned")
  sizeKb            Int      @default(0) @map("size_kb")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("email_logs")
}

// ───────────────── M23 — Advanced Identity & NAC (spec 2.9 + 2.10) ─────────────────

model FederatedIdp {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @default(1) @map("tenant_id")
  name         String
  protocol     String   @default("saml2") // saml2 | oidc
  entityId     String?  @map("entity_id")
  metadataUrl  String?  @map("metadata_url") // sandbox: simulated metadata fetch
  ssoUrl       String?  @map("sso_url")
  clientId     String?  @map("client_id")
  clientSecret String?  @map("client_secret") // masked in responses
  idpCertId    Int?     @map("idp_cert_id") // logical ref → certificates
  redirectUri  String?  @map("redirect_uri")
  status       String   @default("untested") // untested | ok | error
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("federated_idps")
}

model RadiusCoaProfile {
  id               Int      @id @default(autoincrement())
  tenantId         Int      @default(1) @map("tenant_id")
  name             String
  radiusProfileId  Int?     @map("radius_profile_id") // logical ref → radius_profiles
  coaEnabled       Boolean  @default(true) @map("coa_enabled")
  dynamicVlan      Boolean  @default(true) @map("dynamic_vlan")
  vlanPoolStart    Int?     @map("vlan_pool_start")
  vlanPoolEnd      Int?     @map("vlan_pool_end")
  sessionTimeoutMin Int     @default(480) @map("session_timeout_min")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("radius_coa_profiles")
}

model NacProfile {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1) @map("tenant_id")
  name            String
  method          String   @default("802.1x") // 802.1x | mab | both
  eapType         String   @default("peap") @map("eap_type") // peap | ttls | tls
  dynamicVlan     Boolean  @default(true) @map("dynamic_vlan")
  guestVlan       Int?     @map("guest_vlan")
  authFailVlan    Int?     @map("auth_fail_vlan")
  profiling       Boolean  @default(true)
  byodOnboarding  Boolean  @default(false) @map("byod_onboarding")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("nac_profiles")
}

model NacDevice {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1) @map("tenant_id")
  macAddress String   @map("mac_address")
  ip         String
  hostname   String?
  vendor     String?  // OUI lookup (simulated)
  deviceType String   @default("unknown") @map("device_type") // printer | phone | camera | workstation | mobile | iot | unknown
  osGuess    String?  @map("os_guess")
  nacState   String   @default("pending") @map("nac_state") // authenticated | mab | quarantine | pending | denied
  vlanId     Int?     @map("vlan_id")
  riskScore  Int      @default(30) @map("risk_score")
  nacProfileId Int?   @map("nac_profile_id")
  firstSeen  DateTime @default(now()) @map("first_seen")
  lastSeen   DateTime @default(now()) @map("last_seen")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, macAddress])
  @@index([tenantId, nacState])
  @@map("nac_devices")
}

model ByodEnrollment {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @default(1) @map("tenant_id")
  userName  String    @map("user_name")
  deviceId  Int?      @map("device_id") // logical ref → nac_devices
  token     String    // one-time enrollment token (one-time secret rule)
  status    String    @default("pending") // pending | approved | enrolled | expired | revoked
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, token])
  @@map("byod_enrollments")
}

model IdentityActivityEvent {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1) @map("tenant_id")
  userName  String   @map("user_name")
  event     String   // login | logout | portal | vpn | coa | vlan_change | nac_auth | idp_sso
  sourceIp  String?  @map("source_ip")
  detail    String   @default("{}") // JSON
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("identity_activity_events")
}

/// Phase-1 tail (2026-11-07): real webhook delivery ledger — M11 §5.6 divergence closed.
model WebhookDelivery {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1) @map("tenant_id")
  webhookId  Int      @map("webhook_id")
  event      String   @default("alerts.new")
  payload    String   @default("{}") // JSON body actually POSTed
  ok         Boolean  @default(false)
  statusCode Int?     @map("status_code")
  durationMs Int?     @map("duration_ms")
  attempts   Int      @default(1) @map("attempts")
  error      String?  // timeout / DNS / connection-refused detail
  signature  String?  // HMAC-SHA256 hex prefix (first 16) for audit correlation
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, webhookId, createdAt])
  @@map("webhook_deliveries")
}
