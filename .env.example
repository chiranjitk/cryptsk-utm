# Cryptsk Console — production environment template (Debian 13 appliance).
# Copy to .env, chmod 600, fill every value. NEVER commit the real file.

# ── database ──────────────────────────────────────────────────────────────────
# Sandbox default (this repo): file:/home/z/my-project/db/cryptsk.db
# Production: PostgreSQL 16 per ADR-005 (see DEPLOYMENT.md §3)
DATABASE_URL="postgresql://cryptsk:CHANGE_ME@127.0.0.1:5432/cryptsk"

# ── auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_64_HEX"
NODE_ENV=production

# ── adapter mode (ADR-004) ────────────────────────────────────────────────────
# simulated = in-console MockEngine (sandbox/staging)
# agent     = real appliance data-plane via the Go agent (spec §3)
ADAPTER_MODE=simulated
AGENT_BASE_URL="http://127.0.0.1:8080"
AGENT_SHARED_SECRET="CHANGE_ME_64_HEX"

# ── realtime mini-service (socket.io, ADR-008) ───────────────────────────────
REALTIME_PORT=3003
