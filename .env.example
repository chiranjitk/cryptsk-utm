# Cryptsk Console — environment template (Debian 13 appliance + sandbox).
# Copy to .env, chmod 600, fill every value. NEVER commit the real file.

# ── database ──────────────────────────────────────────────────────────────────
# Sandbox default (this repo): file:/home/z/my-project/db/cryptsk.db
# Production default (deploy script): file:/opt/cryptsk/console/db/cryptsk.db
# Optional PostgreSQL 16 switch per ADR-005 (see DEPLOYMENT.md §3):
# DATABASE_URL="postgresql://cryptsk:CHANGE_ME@127.0.0.1:5432/cryptsk"
DATABASE_URL="file:/opt/cryptsk/console/db/cryptsk.db"

# ── auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32 (AUTH_SECRET is read by the code; JWT_SECRET
# is kept as a documented alias)
AUTH_SECRET="CHANGE_ME_64_HEX"
JWT_SECRET="CHANGE_ME_64_HEX"
NODE_ENV=production

# ── data plane / adapter mode (ADR-004 + ADR-021) ─────────────────────────────
# host      = REAL host telemetry via HostCollector — /proc, sysfs, gateway
#             probes, systemctl, Suricata eve.json, wg, Kea, unbound (DEFAULT;
#             no mock data anywhere)
# simulated = legacy in-console MockEngine demo plane (sandbox demos only)
ADAPTER_MODE=host
# Future remote-agent transport (appliance integration, AGENT_ADAPTER_CHECKLIST):
AGENT_BASE_URL="http://127.0.0.1:8080"
AGENT_SHARED_SECRET="CHANGE_ME_64_HEX"

# ── realtime mini-service (socket.io, ADR-008) ───────────────────────────────
# Port is fixed at 3003 in mini-services/realtime-service (gateway forwards
# via XTransformPort in the sandbox; Caddy /realtime path on the appliance).
INTERNAL_TOKEN="CHANGE_ME_24_HEX"
